# 所有文本文件默认使用 LF
* text=auto

# 明确指定这些文件类型使用 LF
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# 标记二进制文件，防止 Git 尝试转换
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

