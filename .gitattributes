# 明确指定这些文件类型使用 LF（覆盖 text=auto）
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.sql text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.bat text eol=lf # Windows 批处理文件，注意它需要 CRLF？实际上现代 Windows 也支持 LF，但为了兼容性可以考虑保留

# 标记二进制文件
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# 所有文本文件默认使用 LF
* text=auto
